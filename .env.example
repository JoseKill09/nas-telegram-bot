# -----------------------------------------------------------------------------
# NAS Telegram Bot - example settings / ajustes de ejemplo
#
# EN: Copy this file to `.env` (cp .env.example .env) and fill in your values.
#     Only BOT_TOKEN and OWNER_ID are required. Everything else is optional and
#     most of it can be set later from the bot itself (Settings / /setup).
#     NEVER publish or share your real `.env`.
#
# ES: Copia este archivo como `.env` (cp .env.example .env) y rellena tus datos.
#     Solo BOT_TOKEN y OWNER_ID son obligatorios. El resto es opcional y casi
#     todo se puede poner luego desde el propio bot (Ajustes / /setup).
#     NUNCA publiques ni compartas tu `.env` real.
# -----------------------------------------------------------------------------

# --- Required / Obligatorio ---------------------------------------------------
# EN: Token from @BotFather.
# ES: Token de @BotFather.
BOT_TOKEN=
# EN: Your numeric Telegram user ID (ask @userinfobot).
# ES: Tu ID de usuario de Telegram (te lo da @userinfobot).
OWNER_ID=

# --- General ------------------------------------------------------------------
# EN: Time zone, for example Europe/Madrid or America/Mexico_City.
# ES: Zona horaria, por ejemplo Europe/Madrid o America/Mexico_City.
TZ=UTC
# EN: Interface language: en | es (empty = ask on the first /start).
# ES: Idioma: en | es (en blanco = preguntar en el primer /start).
LANGUAGE=
# EN: NAS folder shared with the containers as /media.
# ES: Carpeta del NAS que se comparte con los contenedores como /media.
MEDIA_ROOT=./data/media
# EN: Max CPU cores the bot may use.
# ES: Cantidad de CPU que puede usar el bot como mucho.
BOT_CPUS=2
# EN: Telegram Rich Messages (1 = on, 0 = classic HTML messages).
# ES: Mensajes enriquecidos de Telegram (1 = activados, 0 = mensajes HTML de siempre).
RICH_MESSAGES=1

# --- aria2 (direct downloads / descargas directas) ----------------------------
# EN: Shared secret between the bot and aria2: change it to a long random value.
# ES: Secreto compartido entre el bot y aria2: pon un valor largo y aleatorio.
ARIA2_SECRET=change-this-secret
ARIA2_HOST=http://aria2
ARIA2_PORT=6800

# --- Web app (Telegram Mini App) - optional / opcional ------------------------
# EN: Can also be set from Settings -> Web app.
# ES: Se puede poner desde Ajustes -> Web app.
WEBAPP_ENABLED=0
WEBAPP_URL=
WEBAPP_PORT=8080
# EN: Port of the web panel on your local network (Settings -> Web app -> Local network).
# ES: Puerto del panel web en tu red local (Ajustes -> Web app -> Red local).
WEBAPP_LAN_PORT=8080
# EN: Initial Cloudflare Tunnel token (normally pasted from the bot).
#     See docs/en/web-app-hosting.md
# ES: Token inicial de Cloudflare Tunnel (normalmente se pega desde el bot).
#     Mira docs/es/web-app-hosting.md
CLOUDFLARE_TUNNEL_TOKEN=

# --- External API - optional / API externa - opcional -------------------------
# EN: If set (24 characters or more), the REST API also accepts
#     "Authorization: Bearer <API_TOKEN>" and acts as the owner.
#     Leave it empty to disable it. Generate one with: openssl rand -hex 32
#     See docs/en/api.md
# ES: Si lo rellenas (con al menos 24 caracteres), la API REST permite usar
#     "Authorization: Bearer <API_TOKEN>" y funciona como el propietario.
#     Si lo dejas en blanco, queda desactivada. Genera uno con: openssl rand -hex 32
#     Mira docs/es/api.md
API_TOKEN=

# --- Userbot (big Telegram files / archivos grandes de Telegram) - optional ---
# EN: From my.telegram.org. Can also be set from Settings -> Userbot.
#     See docs/en/userbot.md
# ES: De my.telegram.org. Se puede poner desde Ajustes -> Userbot.
#     Mira docs/es/userbot.md
API_ID=
API_HASH=
CHANNEL_ID=
USERBOT_MAX_CONNECTIONS=20

# --- Google Drive - optional / opcional ---------------------------------------
# EN: From Google Cloud Console. Can also be set from Settings -> Google Drive.
#     See docs/en/google-drive.md
# ES: De Google Cloud Console. Se puede poner desde Ajustes -> Google Drive.
#     Mira docs/es/google-drive.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# EN: Empty = WEBAPP_URL + /oauth2/google/callback
# ES: En blanco = WEBAPP_URL + /oauth2/google/callback
GOOGLE_REDIRECT_URI=
